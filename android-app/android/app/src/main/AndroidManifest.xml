<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used when the user sends a chat message or asks for the balance. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only while the hold-to-talk button is pressed: on-device recognition. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/pet_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ChatActivity" android:exported="false"
            android:label="@string/chat_title" android:windowSoftInputMode="adjustResize" />
        <service android:name=".PetOverlayService" android:exported="false"
            android:foregroundServiceType="specialUse" android:stopWithTask="false">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started interactive desktop pet displayed in a small application overlay; paused on screen off and stoppable from its notification." />
        </service>
    </application>
</manifest>
